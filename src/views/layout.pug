doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || "StudyBuddy"
    link(rel="stylesheet" href="/css/style.css")

  body
    header
      h1 StudyBuddy
      nav
        if user
          a(href="/") Home
          a(href="/subjects") Subject
          a(href="/messages") Message
          a(href="/streaks") Streaks
          a(href="/notifications") Notification
          a(href="/profile") Profile
          a(href="/logout") Logout
        else
          a(href="/login") Login
          a(href="/login#about-studybuddy") About
          a(href="/register") Register

    hr

    main
      block content
