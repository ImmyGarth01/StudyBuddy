extends layout

block content
  .container
    h1 Your Study Streak

    .streak-card(style="background: linear-gradient(135deg, #1e293b, #0f172a); padding: 20px; border-radius: 24px; text-align: center; margin-bottom: 30px;")
      h2(style="font-size: 48px; margin: 0;") 🔥 #{streak}
      p(style="font-size: 18px; margin: 5px 0 0;") day streak!

    h2 Your Upcoming & Past Sessions

    if listings && listings.length
      .listings-container
        each listing in listings
          .listing-card
            h3
              a(href=`/listings/${listing.listing_id}`) #{listing.title}
            p.module Module: #{listing.module}
            p.location Location: #{listing.location}
            p.time #{new Date(listing.start_time).toLocaleString()}
            p.status Status: #{listing.status}

            .participants-section
              strong Participants:
              if listing.participants && listing.participants.length
                span.participants-list
                  each participant, index in listing.participants
                    span.participant-hover
                      = participant.user_id === user.user_id ? "You" : participant.first_name
                      if index < listing.participants.length - 1
                        | ,

                      .participant-tooltip
                        p Name: #{participant.first_name}
                        p Degree: #{participant.degree}
                        p Email: #{participant.email}
              else
                p No participants yet

            if listing.user_id === user.user_id
              form(action=`/streaks/delete/${listing.listing_id}` method="POST")
                button(type="submit") Delete Study Session
            else
              form(action=`/streaks/leave/${listing.listing_id}` method="POST")
                button(type="submit") Leave Study Session
    else
      p You are not part of any study sessions yet. 
        a(href="/subjects") Browse subjects
        |  to join one!