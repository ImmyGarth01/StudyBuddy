extends layout

block content

  h2 Study Sessions
  p Find study partners or browse available study sessions.

  .listings-container
    each listing in listings
      .listing-card
        img.profile(src="/images/bookIcon.png")

        h3= listing.title

        p
          strong Module:
          | #{listing.module}

        p
          strong Location:
          | #{listing.location}

        - const start = new Date(listing.start_time)

        p
              strong Start time:
              |  #{start.toLocaleDateString('en-GB')} #{start.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}
            
        p
          strong Status:
          | #{listing.status}

        .join-container
          if ownedListingIds.includes(listing.listing_id)
            form(method="POST", action=`/listings/${listing.listing_id}/delete`)
              button.join-btn(type="submit") Delete Your Study Session

          else if acceptedListingIds.includes(listing.listing_id)
            form(method="POST", action=`/listings/${listing.listing_id}/leave`)
              button.join-btn(type="submit") Leave Study Session

          else if requestedListingIds.includes(listing.listing_id)
            button.join-btn(disabled) Request Sent

          else
            form(method="POST", action=`/listings/${listing.listing_id}/join`)
              button.join-btn(type="submit") Request to Join 